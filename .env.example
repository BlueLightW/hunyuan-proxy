# Configurações do Proxy Hunyuan
HUNYUAN_PROXY_TOKEN=your-secret-token
HUNYUAN_PROXY_PORT=8787
HUNYUAN_PROXY_REQUIRE_AUTH=true

# Configurações da API Tencent Hunyuan
TENCENT_API_URL=https://api.hy.tencent.ai/api/new-portal/chat/dbroaac2c3md47t9bgc0
TENCENT_LOGIN_URL=https://aistudio.tencent.ai
TENCENT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Multi-account settings (opcional)
HUNYUAN_MULTI_ACCOUNT=false
HUNYUAN_ACCOUNT_POOL_SIZE=5
HUNYUAN_ACCOUNT_COOLDOWN_MS=60000
HUNYUAN_MAX_CONCURRENCY=10
HUNYUAN_DB_PATH=./data/accounts.db

# Upstream opcional (para proxy de outras rotas)
HUNYUAN_UPSTREAM_URL=http://127.0.0.1:4096
HUNYUAN_UPSTREAM_PASSWORD=